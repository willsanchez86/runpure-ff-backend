{
  "name": "runpure-ff-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Runpure FF backend: GraphQL API, nflverse ETL pipeline, scheduled jobs, backfill",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run schema && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schema": "tsx src/graphql/print-schema.ts",
    "spike": "tsx src/jobs/spike-yoga.ts",
    "ingest": "tsx src/jobs/ingest.ts",
    "backfill": "tsx src/jobs/backfill.ts",
    "headers": "tsx src/jobs/headers.ts",
    "lint": "eslint src",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@graphql-yoga/plugin-persisted-operations": "^4.0.1",
    "@pothos/core": "^4.16.0",
    "@pothos/plugin-scope-auth": "^4.2.2",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "firebase-admin": "^14.5.0",
    "graphql": "^17.1.0",
    "graphql-yoga": "^6.0.1",
    "mysql2": "^3.24.6",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0"
  }
}
